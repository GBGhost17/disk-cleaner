{
  "version": 1,
  "targets": [
    {
      "id": "user_temp",
      "path": "%TEMP%",
      "category": "temp",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Temp của user hiện tại, an toàn để dọn"
    },
    {
      "id": "localappdata_temp",
      "path": "%LOCALAPPDATA%\\Temp",
      "category": "temp",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Temp ứng dụng theo user, thường có thể dọn"
    },
    {
      "id": "wer_local_reports",
      "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER",
      "category": "windows_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Báo cáo lỗi cục bộ (Windows Error Reporting)"
    },
    {
      "id": "explorer_thumbnail_cache",
      "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",
      "category": "windows_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Thumb cache Explorer, Windows sẽ tự tạo lại"
    },
    {
      "id": "chrome_cache",
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Cache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Cache Chrome, tự tạo lại"
    },
    {
      "id": "chrome_code_cache",
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Code Cache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Code cache Chrome"
    },
    {
      "id": "chrome_gpu_cache",
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\GPUCache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "GPU cache Chrome"
    },
    {
      "id": "edge_cache",
      "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Cache Edge, tự tạo lại"
    },
    {
      "id": "edge_code_cache",
      "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Code Cache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Code cache Edge"
    },
    {
      "id": "edge_gpu_cache",
      "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\GPUCache",
      "category": "browser_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "GPU cache Edge"
    },
    {
      "id": "microsoft_teams_cache",
      "path": "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache",
      "category": "app_cache",
      "safety": "safe",
      "action": "delete_contents",
      "note": "Cache Microsoft Teams (nếu có)"
    },
    {
      "id": "downloads_review",
      "path": "%USERPROFILE%\\Downloads",
      "category": "manual_review",
      "safety": "caution",
      "action": "manual_review",
      "note": "Xem thủ công file tải về cũ, không tự động xóa"
    },
    {
      "id": "desktop_review",
      "path": "%USERPROFILE%\\Desktop",
      "category": "manual_review",
      "safety": "caution",
      "action": "manual_review",
      "note": "Xem thủ công tệp cũ trên Desktop, không tự động xóa"
    },
    {
      "id": "winsxs_cleanup_manual",
      "path": "C:\\Windows\\WinSxS",
      "category": "system",
      "safety": "caution",
      "action": "dism_cleanup",
      "note": "Gợi ý chạy DISM StartComponentCleanup thủ công; không xóa trực tiếp WinSxS"
    },
    {
      "id": "windows_system32",
      "path": "C:\\Windows\\System32",
      "category": "system",
      "safety": "dangerous",
      "action": "never_touch",
      "note": "Nhắc nhở vùng hệ thống nguy hiểm, không bao giờ xử lý"
    },
    {
      "id": "program_files",
      "path": "C:\\Program Files",
      "category": "system",
      "safety": "dangerous",
      "action": "never_touch",
      "note": "Nhắc nhở: chỉ gỡ app qua Settings, không xóa thư mục"
    },
    {
      "id": "program_files_x86",
      "path": "C:\\Program Files (x86)",
      "category": "system",
      "safety": "dangerous",
      "action": "never_touch",
      "note": "Nhắc nhở: chỉ gỡ app qua Settings, không xóa thư mục"
    },
    {
      "id": "program_data",
      "path": "C:\\ProgramData",
      "category": "system",
      "safety": "dangerous",
      "action": "never_touch",
      "note": "Dữ liệu ứng dụng dùng chung, không xóa thủ công"
    }
  ]
}